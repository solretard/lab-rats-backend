# Supabase — project settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Xaman (Xumm) — apps.xumm.dev, create a new app
XUMM_API_KEY=your-xumm-api-key
XUMM_API_SECRET=your-xumm-api-secret

# XRPL
XRPL_NETWORK=wss://xrplcluster.com

# Project wallet — this ONE wallet does everything: holds staked NFTs,
# issues $RPLTS, and pays out rewards. Merged setup (simpler, but this
# wallet's mnemonic is now the single most sensitive secret in the project —
# protect it accordingly).
# Fund it with a small amount of XRP for reserves + transaction fees.
# NEVER commit real values to git.
# Use ONE of the two lines below — mnemonic is preferred if you have it.
PROJECT_WALLET_MNEMONIC=word1 word2 word3 ... word12
# PROJECT_WALLET_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXX
PROJECT_WALLET_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# $RPLTS token — same address as PROJECT_WALLET_ADDRESS above, since this
# wallet is both the issuer and the one paying out rewards.
RPLTS_ISSUER_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RPLTS_CURRENCY_CODE=RPLTS

PORT=3000
